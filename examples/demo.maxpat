                    "patching_rect": [ 1120.0, 624.0, 236.0, 22.0 ],
                    "text": "jit.gl.shader @embed 1 @name rectangles",
                    "textfile": {
                        "text": "<jittershader name=\"fill-flat-triangles\">\n\t<description>Default Shader </description>\n\t<param name=\"position\" type=\"vec3\" state=\"POSITION\" />\n\t<param name=\"modelViewProjectionMatrix\" type=\"mat4\" state=\"MODELVIEW_PROJECTION_MATRIX\" />\n    <param name=\"instance_pos\" type=\"vec4\" state=\"VERTEX_ATTR\" />\n\t<param name=\"color\" type=\"vec4\" state=\"COLOR\" />\n    <param name=\"viewPort\" type=\"vec2\" state=\"VIEWPORT\" />\n\t<language name=\"glsl\" version=\"1.5\">\n\t\t<bind param=\"position\" program=\"vp\" />\n\t\t<bind param=\"modelViewProjectionMatrix\" program=\"vp\" />\n        <bind param=\"instance_pos\" program=\"vp\" />\n\t\t<bind param=\"color\" program=\"vp\" />\n        <bind param=\"viewPort\" program=\"vp\" />\n\t\t<program name=\"vp\" type=\"vertex\">\n<![CDATA[\n#version 330 core\nuniform mat4 modelViewProjectionMatrix;\nuniform vec2 viewPort;\n\nin vec3 position;\nin vec4 instance_pos;\nin vec4 color;\n\nout jit_PerVertex {\n\tflat vec4 color;\t\n} jit_out;\n\nvoid main() {\t\n\n    vec2 center = instance_pos.xy;\n    center.y = 1.0 - center.y;\n    vec2 extent = instance_pos.zw;\n\n    vec3 pos = vec3(center, 0.0);\n    pos.xy += extent * position.xy;\n    pos.xy = pos.xy*2 - 1;\n    pos.x *= viewPort.x / viewPort.y;\n\tgl_Position = modelViewProjectionMatrix * vec4(pos, 1.);\t\n\tjit_out.color = color;\n}\n]]>\n\t\t</program>\n\t\t<program name=\"fp\" type=\"fragment\">\n<![CDATA[\n#version 330 core\n\nin jit_PerVertex {\n\tflat vec4 color;\n} jit_in;\n\nout vec4 color;\n\nvoid main() {\n\tcolor = jit_in.color;\n}\t\n]]>\n\t\t</program>\n\t</language>\n</jittershader>\n",
                        "filename": "none",
                        "flags": 1,
                        "embed": 1,
                        "autowatch": 1
                    }
                }
            },
