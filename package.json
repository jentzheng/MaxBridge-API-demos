    "@eslint/js": "^10.0.1",
    "@huggingface/transformers": "^4.3.2",
    "@mediapipe/tasks-vision": "^1.2.2",
    "@rolldown/plugin-babel": "^0.3.0",
    "@tailwindcss/vite": "^4.3.4",
    "@tanstack/eslint-plugin-router": "^1.162.0",
    "@tanstack/react-form": "^1.33.5",
