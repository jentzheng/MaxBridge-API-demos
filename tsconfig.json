{
  "compilerOptions": {
    "target": "ES2021",
    "module": "commonjs",
    "moduleResolution": "node",
    "noImplicitAny": false,
    "strict": true,
    "incremental": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "javascript",
    "baseUrl": "./",
    "paths": {
      "@web/*": ["./socket-server-with-web/src/*"]
    }
  },
  "include": ["src"]
}
