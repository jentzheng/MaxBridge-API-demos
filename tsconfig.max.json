{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.max.tsbuildinfo",
    "lib": ["ES2025"],
    "module": "none",
    "ignoreDeprecations": "6.0",
    "skipLibCheck": true,

    "esModuleInterop": true,
    /* Output */
    "rootDir": "./v8-src",
    "outDir": "./examples",
    "noEmit": false,

    /* Linting */
    "strict": true
  },
  "include": ["./v8-src/*.ts", "jsthis.d.ts"]
}
