{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.max.tsbuildinfo",
    "target": "es2025",
    "lib": ["ES2025"],
    "skipLibCheck": true,

    /* Max v8 loads a plain script: no import/export, no module wrapper */
    "module": "esnext",
    "moduleDetection": "legacy",

    /* Output */
    "rootDir": ".",
    "outDir": "./examples",
    "noEmit": false,

    /* Linting */
    "strict": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["./v8-wsclient.ts", "jsthis.d.ts"]
}
